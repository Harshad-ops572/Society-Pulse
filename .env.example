# Database (MongoDB Atlas connection string, or leave blank for local memory persistence fallback)
MONGODB_URI=

# AI Model Key (Gemini API Key from Google AI Studio, or leave blank for intelligent heuristic fallback)
GEMINI_API_KEY=

# Authentication Secret (Random string for JWT signing)
NEXTAUTH_SECRET=societypulse-secret-key-32chars-min-changeinprod

# Base URL
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob Token (for photo uploads in cloud production)
BLOB_READ_WRITE_TOKEN=

# Secret key to authenticate cron jobs (/api/cron/*)
CRON_SECRET=societypulse-cron-secret-key-1234
