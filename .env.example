# Database (MongoDB Atlas connection string, e.g. mongodb+srv://...)
MONGODB_URI=

# AI Model Key (Gemini API Key from Google AI Studio, or leave blank for heuristic fallback)
GEMINI_API_KEY=

# Authentication Secret (Used for JWT signing)
NEXTAUTH_SECRET=

# Base URL
NEXTAUTH_URL=http://localhost:3000

# Demo Mode (Enable 1-Click "Try as committee member" for judges/evaluators)
# Set to 'true' to allow 1-click evaluation access, or 'false' in production. Default is false.
DEMO_MODE=false

# Optional Seed Passwords (if unset, random cryptographically secure passwords will be printed upon seed)
SEED_ADMIN_PASSWORD=
SEED_MEMBER_PASSWORD=

# Cron / Maintenance Secret
CRON_SECRET=
